doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover")
    meta(name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)")
    meta(name="theme-color" content="#131518" media="(prefers-color-scheme: dark)")
    title= pageTitle ? pageTitle + ' · Note taker' : 'Note taker'
    link(rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png")
    link(rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png")
    link(rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png")
    link(rel="manifest" href="/site.webmanifest")
    link(rel="stylesheet" href="/stylesheets/style.css")
  body(class=bodyClass)
    if user
      header.topbar
        a.brand(href="/")
          img(src="/favicon-32x32.png" alt="" width="24" height="24")
          span Note taker
        .account
          if user.photo
            img.avatar(src=user.photo alt="" width="28" height="28" referrerpolicy="no-referrer")
          span.account-email= user.email
          form(action="/auth/logout" method="POST")
            button.link-button(type="submit") Sign out
    main.main
      block content
    block scripts
