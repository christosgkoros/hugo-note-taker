extends layout

block content
  form.composer(action="/" method="POST" data-composer)
    .composer-head
      h1 New note
      if suggested
        p.muted Review the suggestions, edit anything you like, then publish.
      else
        p.muted Leave the title or tags empty and AI will suggest them.

    if error
      .alert(role="alert")= error

    .field
      label(for="note") Note
      textarea#note(name="note" rows="6" required placeholder="What's on your mind?" autofocus=!note)= note
      .field-meta
        span(data-count) #{note ? note.length : 0} characters
        if mastodon
          span.muted(data-mastodon hidden) Mastodon shows the first 447

    .field
      label(for="source") Source
        span.optional optional
      input#source(type="url" name="source" value=source placeholder="https://" inputmode="url" autocomplete="off")

    .field-row
      .field
        label(for="title") Title
          if suggested
            span.badge AI
        input#title(type="text" name="title" value=title placeholder="Suggested by AI if empty" autocomplete="off")
      .field
        label(for="tags") Tags
          if suggested
            span.badge AI
        input#tags(type="text" name="tags" value=tags placeholder="apis leadership ai" autocomplete="off" autocapitalize="none")
        .chips(data-chips aria-hidden="true")

    .composer-actions
      button.button.button-primary(type="submit" data-submit)
        span.spinner(aria-hidden="true")
        span(data-label)= (title && tags) ? 'Publish' : 'Suggest title & tags'
      span.hint.muted
        kbd ⌘
        kbd ↵
        |  to submit

block scripts
  script(src="/javascripts/composer.js" defer)
